<!-- Patterned Hero Carousel (Light Blue Theme - Pure CSS Gradients, Geometric Patterns & Bold Typography) -->
<section class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 mt-3 md:mt-5">
  <div class="relative rounded-2xl overflow-hidden shadow-xl border border-sky-400/30" id="heroCarousel">
    
    <!-- Slides Container -->
    <div class="relative w-full h-[230px] sm:h-[280px] md:h-[340px] overflow-hidden" id="heroSlidesWrapper">
      
      <!-- Slide 1: END OF REASON SALE (EORS) - Light Blue & Deep Ocean Theme -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-700 ease-in-out opacity-100 z-10 hero-eors-bg flex flex-col justify-between p-5 sm:p-8 md:p-10 text-white">
        <!-- Background Abstract Geometric Accents -->
        <div class="absolute -right-12 -top-12 w-48 h-48 md:w-80 md:h-80 rounded-full border-8 border-sky-400/20 pointer-events-none"></div>
        <div class="absolute right-20 -bottom-16 w-36 h-36 md:w-60 md:h-60 rounded-full border-4 border-cyan-300/20 pointer-events-none"></div>
        <div class="absolute right-1/4 top-1/3 w-16 h-16 bg-gradient-to-tr from-sky-400/30 to-cyan-300/30 rotate-45 pointer-events-none hidden sm:block"></div>

        <!-- Top Badges & Countdown -->
        <div class="relative z-10 flex items-center justify-between flex-wrap gap-2">
          <div class="inline-flex items-center gap-1.5 bg-gradient-to-r from-[#0284c7] to-[#0ea5e9] px-3 py-1 rounded-full text-[10px] sm:text-xs font-black uppercase tracking-wider shadow-md border border-sky-300/30">
            <span>★</span>
            <span>END OF REASON SALE</span>
            <span>★</span>
          </div>

          <div class="inline-flex items-center gap-2 bg-slate-900/60 backdrop-blur-md px-3 py-1 rounded-full text-[11px] sm:text-xs font-mono font-bold border border-sky-400/30">
            <span class="text-sky-300">ENDS IN:</span>
            <span id="countdownTimer" class="tracking-widest text-white">08h : 42m : 19s</span>
          </div>
        </div>

        <!-- Main Banner Center Content -->
        <div class="relative z-10 my-auto py-2">
          <p class="text-xs sm:text-sm md:text-base font-extrabold uppercase tracking-widest text-sky-300 mb-1">
            INDIA'S BIGGEST WOMEN'S FASHION CARNIVAL
          </p>
          <h2 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight leading-none text-white drop-shadow-md">
            FLAT <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-200 via-cyan-300 to-white">50-80%</span> OFF
          </h2>
          <p class="text-xs sm:text-sm font-medium text-sky-100/90 mt-1 sm:mt-2 max-w-md">
            Top Designer Brands • Biba, FabIndia, H&M, Libas, Mango & More
          </p>
        </div>

        <!-- Bottom Action Strip -->
        <div class="relative z-10 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <button 
              type="button" 
              onclick="applyCategoryFilter('sale')" 
              class="badge-shimmer bg-white text-[#0369a1] hover:bg-sky-50 font-black text-xs sm:text-sm px-5 py-2 sm:px-6 sm:py-2.5 rounded-full shadow-lg transition-transform active:scale-95 flex items-center gap-1.5"
            >
              <span>GRAB DEALS</span>
              <span class="text-[#0ea5e9]">→</span>
            </button>
            <span class="hidden sm:inline-block text-[11px] text-sky-100 font-semibold bg-white/10 px-3 py-1.5 rounded-full border border-white/15">
              ⚡ Extra ₹300 OFF with code <strong class="text-sky-300">MOOD300</strong>
            </span>
          </div>

          <div class="hidden md:flex items-center gap-3">
            <span class="text-[11px] uppercase tracking-wider text-sky-200/80 font-semibold">100% Authentic Quality</span>
          </div>
        </div>
      </div>

      <!-- Slide 2: STREETWEAR PULSE // DROP 04 (Cyber Midnight & Cyan) -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-700 ease-in-out opacity-0 z-0 hero-streetwear-bg flex flex-col justify-between p-5 sm:p-8 md:p-10 text-white">
        <!-- Cyber Accents -->
        <div class="absolute right-12 top-6 w-32 h-32 rounded-lg border-2 border-cyan-400/30 rotate-12 pointer-events-none"></div>

        <!-- Top Badges -->
        <div class="relative z-10 flex items-center justify-between">
          <div class="inline-flex items-center gap-1.5 bg-cyan-400 text-slate-950 px-3 py-1 rounded-full text-[10px] sm:text-xs font-black uppercase tracking-wider shadow-md">
            <span>●</span>
            <span>WESTERN DRESSES & TRENDING CO-ORDS</span>
          </div>
          <span class="text-cyan-300 font-mono text-xs font-bold tracking-widest hidden sm:inline">TRENDING NOW</span>
        </div>

        <!-- Main Text -->
        <div class="relative z-10 my-auto py-2">
          <p class="text-xs sm:text-sm font-mono uppercase tracking-widest text-cyan-300 mb-1">
            BODYCON • TIERED MAXIS • SATIN WRAPS • MATCHED SETS
          </p>
          <h2 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight leading-none text-white">
            MIN. <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-sky-200 to-white">50%</span> OFF
          </h2>
          <p class="text-xs sm:text-sm font-medium text-slate-300 mt-1 sm:mt-2">
            Statement dresses starting from ₹799
          </p>
        </div>

        <!-- Bottom Action -->
        <div class="relative z-10 flex items-center gap-3">
          <button 
            type="button" 
            onclick="applyCategoryFilter('dresses')" 
            class="bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-black text-xs sm:text-sm px-5 py-2 sm:px-6 sm:py-2.5 rounded-full shadow-lg transition-transform active:scale-95 flex items-center gap-1.5"
          >
            <span>SHOP DRESSES</span>
            <span>→</span>
          </button>
        </div>
      </div>

      <!-- Slide 3: FESTIVE SAPPHIRE & ETHNIC WEAR -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-700 ease-in-out opacity-0 z-0 hero-ethnic-bg flex flex-col justify-between p-5 sm:p-8 md:p-10 text-white">
        <!-- Top Badges -->
        <div class="relative z-10 flex items-center justify-between">
          <div class="inline-flex items-center gap-1.5 bg-sky-400 text-sky-950 px-3 py-1 rounded-full text-[10px] sm:text-xs font-black uppercase tracking-wider shadow-md">
            <span>✦</span>
            <span>GRAND ETHNIC UTSAV</span>
            <span>✦</span>
          </div>
          <span class="text-sky-300 font-serif italic text-xs hidden sm:inline">Handcrafted Perfection</span>
        </div>

        <!-- Main Text -->
        <div class="relative z-10 my-auto py-2">
          <p class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-sky-200 mb-1">
            SILK KURTAS • ANARKALIS • CHANDERI SAREES
          </p>
          <h2 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight leading-none text-sky-50">
            UP TO <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-200 via-cyan-100 to-white">70%</span> OFF
          </h2>
          <p class="text-xs sm:text-sm font-medium text-sky-100 mt-1 sm:mt-2">
            Featuring Biba, FabIndia, Libas, Anouk & W for Woman
          </p>
        </div>

        <!-- Bottom Action -->
        <div class="relative z-10 flex items-center gap-3">
          <button 
            type="button" 
            onclick="applyCategoryFilter('kurtas')" 
            class="bg-gradient-to-r from-sky-400 to-cyan-300 hover:from-sky-300 hover:to-cyan-200 text-slate-950 font-black text-xs sm:text-sm px-5 py-2 sm:px-6 sm:py-2.5 rounded-full shadow-lg transition-transform active:scale-95 flex items-center gap-1.5"
          >
            <span>DISCOVER ETHNIC</span>
            <span>→</span>
          </button>
        </div>
      </div>

    </div>

    <!-- Carousel Controls (Previous / Next Buttons) -->
    <button 
      type="button" 
      id="heroPrevBtn" 
      class="absolute left-2 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-slate-900/50 hover:bg-slate-900/80 text-white flex items-center justify-center backdrop-blur-xs transition-opacity opacity-75 hover:opacity-100 focus:outline-none"
      aria-label="Previous Slide"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button 
      type="button" 
      id="heroNextBtn" 
      class="absolute right-2 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-slate-900/50 hover:bg-slate-900/80 text-white flex items-center justify-center backdrop-blur-xs transition-opacity opacity-75 hover:opacity-100 focus:outline-none"
      aria-label="Next Slide"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
    </button>

    <!-- Carousel Indicator Dots -->
    <div class="absolute bottom-2.5 left-1/2 -translate-x-1/2 z-20 flex space-x-1.5" id="heroDots">
      <button type="button" class="hero-dot w-6 h-1.5 rounded-full bg-white transition-all duration-300" data-slide="0" aria-label="Go to slide 1"></button>
      <button type="button" class="hero-dot w-2 h-1.5 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300" data-slide="1" aria-label="Go to slide 2"></button>
      <button type="button" class="hero-dot w-2 h-1.5 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300" data-slide="2" aria-label="Go to slide 3"></button>
    </div>

  </div>
</section>
