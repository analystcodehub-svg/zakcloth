<!-- Sticky Top Navigation Bar (Light Blue Theme) -->
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md shadow-xs border-b border-sky-100">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 md:h-16 gap-2 md:gap-6">
      
      <!-- Mobile Left: Hamburger Button & Logo -->
      <div class="flex items-center gap-2 md:gap-6">
        <!-- Hamburger Menu Button (Mobile) -->
        <button id="hamburgerBtn" type="button" class="md:hidden p-1.5 text-slate-700 hover:text-[#0284c7] focus:outline-none" aria-label="Open navigation menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 md:w-9 md:h-9 rounded-lg bg-gradient-to-tr from-[#0284c7] via-[#0ea5e9] to-[#38bdf8] flex items-center justify-center shadow-md shadow-sky-500/25 group-hover:scale-105 transition-transform">
            <span class="text-white font-black text-sm md:text-base tracking-tighter">SYM</span>
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-sm md:text-base tracking-tight text-slate-900 group-hover:text-[#0284c7] transition-colors leading-tight">
              STYLE YOUR MOOD
            </span>
            <span class="text-[9px] font-bold tracking-widest text-[#0284c7] uppercase">Women's Fashion & Lifestyle</span>
          </div>
        </a>

        <!-- Desktop Navigation Links (Women's Fashion Collections) -->
        <nav class="hidden md:flex items-center space-x-5 lg:space-x-7 ml-6 font-bold text-xs tracking-wider text-slate-800">
          <a href="/?category=kurtas" class="nav-link hover:text-[#0284c7] border-b-2 border-transparent hover:border-[#0284c7] py-5 transition-all">KURTAS & SUITS</a>
          <a href="/?category=sarees" class="nav-link hover:text-[#0284c7] border-b-2 border-transparent hover:border-[#0284c7] py-5 transition-all">SAREES</a>
          <a href="/?category=dresses" class="nav-link hover:text-[#0284c7] border-b-2 border-transparent hover:border-[#0284c7] py-5 transition-all">DRESSES</a>
          <a href="/?category=tops" class="nav-link hover:text-[#0284c7] border-b-2 border-transparent hover:border-[#0284c7] py-5 transition-all">TOPS & SHIRTS</a>
          <a href="/?category=ethnic" class="nav-link hover:text-[#0284c7] border-b-2 border-transparent hover:border-[#0284c7] py-5 transition-all">ETHNIC WEAR</a>
          <a href="/?category=footwear" class="nav-link hover:text-[#0284c7] border-b-2 border-transparent hover:border-[#0284c7] py-5 transition-all">FOOTWEAR & BAGS</a>
          <a href="/studio" class="nav-link text-[#0284c7] flex items-center gap-1 hover:opacity-80 py-5 transition-all">
            STUDIO
            <span class="text-[9px] bg-gradient-to-r from-[#0284c7] to-[#0ea5e9] text-white px-1.5 py-0.2 rounded-full font-extrabold">NEW</span>
          </a>
        </nav>
      </div>

      <!-- Center / Right: Expandable Search Bar -->
      <div class="flex-1 max-w-xs md:max-w-md lg:max-w-lg mx-1 md:mx-4">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-sky-500/70">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Search for brands, clothing, styles..." 
            value="<%= typeof activeSearch !== 'undefined' ? activeSearch : '' %>"
            class="w-full pl-9 pr-8 py-1.5 md:py-2 text-xs md:text-sm bg-sky-50/60 hover:bg-sky-50 focus:bg-white rounded-md border border-sky-100 focus:border-sky-300 focus:outline-none focus:ring-1 focus:ring-[#0ea5e9] transition-all placeholder-slate-400 font-medium text-slate-800"
            autocomplete="off"
          />
          <button id="clearSearchBtn" type="button" class="hidden absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 hover:text-slate-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Right Action Icons: Profile, Wishlist, Bag -->
      <div class="flex items-center space-x-1 md:space-x-5 text-slate-700">
        
        <!-- Profile (Desktop) -->
        <button id="profileBtn" type="button" class="hidden md:flex flex-col items-center p-1 text-xs font-semibold hover:text-[#0284c7] transition-colors">
          <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <span>Profile</span>
        </button>

        <!-- Wishlist Icon with Dynamic Badge -->
        <button id="wishlistTriggerBtn" type="button" class="relative flex flex-col items-center p-1.5 md:p-1 text-xs font-semibold hover:text-[#0284c7] transition-colors" aria-label="Open Wishlist">
          <div class="relative">
            <svg class="w-5 h-5 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
            <span id="wishlistBadge" class="absolute -top-1.5 -right-2 bg-[#0284c7] text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center transform scale-0 transition-transform duration-200 shadow-xs">
              0
            </span>
          </div>
          <span class="hidden md:block mt-0.5">Wishlist</span>
        </button>

        <!-- Bag (Cart) Icon with Dynamic Badge -->
        <button id="cartTriggerBtn" type="button" class="relative flex flex-col items-center p-1.5 md:p-1 text-xs font-semibold hover:text-[#0284c7] transition-colors" aria-label="Open Shopping Bag">
          <div class="relative">
            <svg class="w-5 h-5 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span id="cartBadge" class="absolute -top-1.5 -right-2 bg-[#0284c7] text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center transform scale-0 transition-transform duration-200 shadow-xs">
              0
            </span>
          </div>
          <span class="hidden md:block mt-0.5">Bag</span>
        </button>

      </div>

    </div>
  </div>
</header>
