<!-- Shop by Category Section (Women's Fashion Only - Pure CSS Geometric Patterns & Light Blue Gradients) -->
<section class="mb-8 md:mb-12" id="shopByCategorySection">
  <!-- Section Title -->
  <div class="flex items-center justify-between pb-3 mb-4 border-b border-sky-100">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#0284c7] animate-pulse"></span>
        <h2 class="text-sm sm:text-lg font-black uppercase tracking-wider text-slate-900">
          SHOP BY CATEGORY
        </h2>
      </div>
      <p class="text-[11px] sm:text-xs text-slate-500 font-medium mt-0.5">
        Explore curated ladies fashion collections & trending picks
      </p>
    </div>
    <span class="text-[11px] sm:text-xs font-bold text-[#0284c7] uppercase tracking-wider hidden sm:block">
      Women's Exclusive ✦
    </span>
  </div>

  <!-- Category Cards Grid: 2 columns on mobile, 4 columns on tablet/desktop -->
  <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 lg:gap-5">

    <!-- 1. Kurtas & Suits -->
    <div 
      onclick="selectShopCategory('kurtas')"
      class="group relative rounded-xl overflow-hidden border border-sky-100 shadow-2xs hover:shadow-md hover:border-sky-300 transition-all duration-300 cursor-pointer bg-white flex flex-col justify-between"
    >
      <div class="h-28 sm:h-32 w-full pattern-ethnic-blue relative overflow-hidden flex items-center justify-center">
        <!-- Floating Motif Decor -->
        <div class="absolute -right-4 -bottom-4 w-16 h-16 rounded-full border-2 border-sky-300/30 group-hover:scale-125 transition-transform duration-500"></div>
        <div class="w-14 h-14 rounded-full bg-white/90 backdrop-blur-xs flex items-center justify-center shadow-md group-hover:rotate-12 transition-transform">
          <svg class="w-7 h-7 text-[#0284c7]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 2l3 6-3 3-3-3 3-6zm0 9v11m-6-8l6 3 6-3" />
          </svg>
        </div>
        <div class="absolute top-2 left-2">
          <span class="text-[9px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/90 text-[#0284c7] shadow-xs">
            FROM ₹699
          </span>
        </div>
      </div>
      <div class="p-3 text-center bg-white group-hover:bg-sky-50/50 transition-colors">
        <h3 class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-tight group-hover:text-[#0284c7] transition-colors">
          Kurtas & Suits
        </h3>
        <p class="text-[11px] text-slate-500 font-medium truncate mt-0.5">
          Anarkalis, Straight & Flared
        </p>
      </div>
    </div>

