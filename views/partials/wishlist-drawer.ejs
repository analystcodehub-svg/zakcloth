<!-- Slide-Over Wishlist Drawer (Light Blue Theme) -->
<div id="wishlistDrawer" class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0">
  <!-- Backdrop -->
  <div id="wishlistBackdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-2xs pointer-events-auto" onclick="closeWishlistDrawer()"></div>

  <!-- Drawer Container -->
  <div id="wishlistPanel" class="absolute inset-y-0 right-0 w-full sm:max-w-md bg-white shadow-2xl pointer-events-auto transform translate-x-full transition-transform duration-300 ease-out flex flex-col">
    
    <!-- Header -->
    <div class="px-4 py-3.5 border-b border-sky-100 flex items-center justify-between bg-white flex-shrink-0">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-[#0284c7]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        <span class="text-sm font-black uppercase tracking-wider text-slate-900">
          MY WISHLIST (<span id="wishlistCountHeader">0</span>)
        </span>
      </div>
      <button type="button" onclick="closeWishlistDrawer()" class="text-slate-400 hover:text-slate-700 p-1">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Scrollable Wishlist Items List -->
    <div class="flex-1 overflow-y-auto p-4 space-y-3" id="wishlistContent">
      <div id="wishlistItemsList" class="space-y-3">
        <!-- Rendered dynamically by JS -->
      </div>

      <!-- Empty Wishlist View -->
      <div id="emptyWishlistView" class="hidden flex-col items-center justify-center py-12 text-center">
        <div class="w-20 h-20 rounded-full pattern-polka-dots-blue flex items-center justify-center mb-3">
          <svg class="w-9 h-9 text-[#0284c7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        </div>
        <h4 class="text-sm font-extrabold text-slate-900">Your wishlist is lonely</h4>
        <p class="text-xs text-slate-500 mt-1 max-w-xs">Explore trending styles and tap the heart icon to save your favorites.</p>
        <button type="button" onclick="closeWishlistDrawer();" class="mt-4 px-6 py-2 border-2 border-[#0284c7] text-[#0284c7] hover:bg-[#0284c7] hover:text-white text-xs font-bold uppercase rounded-md transition-colors">
          Browse Styles
        </button>
      </div>
    </div>

  </div>
</div>
