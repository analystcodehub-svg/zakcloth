<!-- Mobile Filter Bottom-Sheet / Full Modal (Light Blue Theme) -->
<div id="filterModal" class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0">
  <!-- Backdrop -->
  <div id="filterBackdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-2xs pointer-events-auto" onclick="closeFilterModal()"></div>

  <!-- Sheet Container -->
  <div id="filterSheet" class="absolute bottom-0 inset-x-0 md:inset-x-auto md:right-0 md:top-0 md:w-[480px] bg-white rounded-t-2xl md:rounded-none shadow-2xl pointer-events-auto transform translate-y-full md:translate-y-0 md:translate-x-full transition-transform duration-300 ease-out h-[85vh] md:h-full flex flex-col">
    
    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-3.5 border-b border-sky-100 flex-shrink-0">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#0284c7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
        <span class="text-sm font-extrabold uppercase tracking-wider text-slate-900">FILTERS</span>
      </div>
      <div class="flex items-center gap-3">
        <button type="button" onclick="clearAllFilters()" class="text-xs font-bold text-[#0284c7] hover:underline uppercase">
          Clear All
        </button>
        <button type="button" onclick="closeFilterModal()" class="text-slate-400 hover:text-slate-700 p-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- 2-Column Body: Tabs on Left, Values on Right -->
    <div class="flex flex-1 overflow-hidden">
      
      <!-- Left Tabs List -->
      <div class="w-1/3 bg-sky-50/40 border-r border-sky-100 flex flex-col overflow-y-auto no-scrollbar text-xs font-bold text-slate-700" id="filterTabList">
        <button type="button" class="filter-tab active text-left px-3.5 py-4 border-l-4 border-[#0284c7] bg-white text-[#0284c7]" onclick="switchFilterTab('categories')">
          Categories
        </button>
        <button type="button" class="filter-tab text-left px-3.5 py-4 border-l-4 border-transparent text-slate-600 hover:bg-sky-50" onclick="switchFilterTab('brands')">
          Brand
        </button>
        <button type="button" class="filter-tab text-left px-3.5 py-4 border-l-4 border-transparent text-slate-600 hover:bg-sky-50" onclick="switchFilterTab('price')">
          Price Range
        </button>
        <button type="button" class="filter-tab text-left px-3.5 py-4 border-l-4 border-transparent text-slate-600 hover:bg-sky-50" onclick="switchFilterTab('discount')">
          Discount
        </button>
      </div>

      <!-- Right Tab Panels -->
      <div class="w-2/3 p-4 overflow-y-auto" id="filterTabPanels">
        
        <!-- Panel 1: Categories (Women Only) -->
        <div id="panel-categories" class="filter-panel space-y-3">
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="checkbox" name="filterCategory" value="Kurtas" class="w-4 h-4 text-[#0284c7] rounded border-slate-300 focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">Kurtas & Suits</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="checkbox" name="filterCategory" value="Sarees" class="w-4 h-4 text-[#0284c7] rounded border-slate-300 focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">Sarees & Drapes</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="checkbox" name="filterCategory" value="Dresses" class="w-4 h-4 text-[#0284c7] rounded border-slate-300 focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">Western Dresses</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="checkbox" name="filterCategory" value="Tops" class="w-4 h-4 text-[#0284c7] rounded border-slate-300 focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">Tops & Shirts</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="checkbox" name="filterCategory" value="Ethnic" class="w-4 h-4 text-[#0284c7] rounded border-slate-300 focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">Festive Lehengas & Ethnic</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="checkbox" name="filterCategory" value="Co-ords" class="w-4 h-4 text-[#0284c7] rounded border-slate-300 focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">Co-ord Sets</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="checkbox" name="filterCategory" value="Footwear" class="w-4 h-4 text-[#0284c7] rounded border-slate-300 focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">Heels & Footwear</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="checkbox" name="filterCategory" value="Bags" class="w-4 h-4 text-[#0284c7] rounded border-slate-300 focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">Handbags & Clutches</span>
          </label>
        </div>

        <!-- Panel 2: Brands -->
        <div id="panel-brands" class="filter-panel hidden space-y-3">
          <% if (typeof allBrands !== 'undefined') { %>
            <% allBrands.forEach(brand => { %>
              <label class="flex items-center space-x-2.5 cursor-pointer">
                <input type="checkbox" name="filterBrand" value="<%= brand %>" class="w-4 h-4 text-[#0284c7] rounded border-slate-300 focus:ring-[#0ea5e9]">
                <span class="text-xs font-semibold text-slate-700"><%= brand %></span>
              </label>
            <% }) %>
          <% } %>
        </div>

        <!-- Panel 3: Price Range -->
        <div id="panel-price" class="filter-panel hidden space-y-3">
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="radio" name="filterPrice" value="all" class="w-4 h-4 text-[#0284c7] focus:ring-[#0ea5e9]" checked>
            <span class="text-xs font-semibold text-slate-700">All Prices</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="radio" name="filterPrice" value="0-800" class="w-4 h-4 text-[#0284c7] focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">Under ₹800</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="radio" name="filterPrice" value="800-1500" class="w-4 h-4 text-[#0284c7] focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">₹800 to ₹1,500</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="radio" name="filterPrice" value="1500-2500" class="w-4 h-4 text-[#0284c7] focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">₹1,500 to ₹2,500</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="radio" name="filterPrice" value="2500-10000" class="w-4 h-4 text-[#0284c7] focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">Above ₹2,500</span>
          </label>
        </div>

        <!-- Panel 4: Discount -->
        <div id="panel-discount" class="filter-panel hidden space-y-3">
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="radio" name="filterDiscount" value="0" class="w-4 h-4 text-[#0284c7] focus:ring-[#0ea5e9]" checked>
            <span class="text-xs font-semibold text-slate-700">All Discounts</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="radio" name="filterDiscount" value="40" class="w-4 h-4 text-[#0284c7] focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">40% and above</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="radio" name="filterDiscount" value="50" class="w-4 h-4 text-[#0284c7] focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">50% and above</span>
          </label>
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="radio" name="filterDiscount" value="60" class="w-4 h-4 text-[#0284c7] focus:ring-[#0ea5e9]">
            <span class="text-xs font-semibold text-slate-700">60% and above</span>
          </label>
        </div>

      </div>
    </div>

    <!-- Sticky Footer Actions -->
    <div class="p-3 border-t border-sky-100 bg-white flex items-center gap-3 flex-shrink-0">
      <button 
        type="button" 
        onclick="closeFilterModal()" 
        class="w-1/2 py-2.5 text-xs font-bold uppercase tracking-wider text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
      >
        Close
      </button>
      <button 
        type="button" 
        onclick="applySelectedFilters()" 
        class="w-1/2 py-2.5 text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-[#0284c7] to-[#0ea5e9] hover:from-[#0369a1] hover:to-[#0284c7] rounded-lg shadow-md shadow-sky-500/25 transition-colors"
      >
        Apply
      </button>
    </div>

  </div>
</div>
